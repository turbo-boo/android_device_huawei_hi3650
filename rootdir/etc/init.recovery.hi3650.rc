on init
    setprop sys.usb.configfs 1
    # Recovery cannot read the adb keys (/data stays encrypted) and has no
    # authorization prompt, so allow adb without it (debuggable builds only).
    setprop ro.adb.secure.recovery 0

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    write /config/usb_gadget/g1/idVendor 0x12d1
    write /config/usb_gadget/g1/idProduct 0x103A
    start adbd
