allow vendor_init config_prop:file { read };
allow vendor_init debugfs:dir { write };
allow vendor_init default_prop:file { read };
allow vendor_init drm_data_file:dir { getattr search };
allow vendor_init init_service_status_prop:property_service { set };
allow vendor_init modem_file:filesystem { getattr };
allow vendor_init nve_block_device:blk_file { open read };
allow vendor_init proc:file { write };
allow vendor_init proc_dirty:file { write };
allow vendor_init proc_hung_task:file { write };
allow vendor_init proc_sched:file { write };
allow vendor_init system_data_file:dir { setattr };
allow vendor_init system_data_file:file { setattr };
allow vendor_init system_prop:file { read };
