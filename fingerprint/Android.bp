cc_library_shared {
    name: "fingerprint.huawei_wrapper",
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    srcs: ["fingerprint_wrapper.c"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
}
